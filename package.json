{
  "name": "qq-bridge",
  "version": "0.4.0-r1",
  "private": true,
  "license": "MIT",
  "description": "独立运行的本地 QQ AI 桥接器：直连模型、会话安全工具、人格、记忆与语音。",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/bridge.js",
    "test:tokens": "node scripts/test-token-usage.mjs",
    "test:reply-wait": "node scripts/test-reply-wait.mjs",
    "self-test": "node src/self-test.js",
    "test:media-search": "node scripts/test-media-search.mjs",
    "test:media-normalize": "node scripts/test-media-normalize.mjs",
    "test-voice:system": "node scripts/test-voice-system.mjs",
    "test:role-card": "node scripts/test-role-card.mjs",
    "test:mcp-servers": "node scripts/test-mcp-servers-stdio.mjs",
    "postinstall": "node scripts/patch-snowluma-sdk.mjs",
    "privacy-scan": "node scripts/privacy-scan.mjs",
    "diagnose:acl": "node scripts/diagnose-acl.mjs",
    "harden-acl": "node scripts/harden-state-acl.mjs",
    "test:direct": "node scripts/test-direct-engine.mjs",
    "start:ui": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-console.ps1 -OpenConsole",
    "test:standalone": "node scripts/test-standalone.mjs",
    "test:engine-settings": "node scripts/test-engine-settings.mjs",
    "test:engine-ui": "node scripts/test-engine-console-ui.mjs",
    "test:snowluma-launcher": "node scripts/test-snowluma-launcher.mjs",
    "test:snowluma-launcher-ui": "node scripts/test-snowluma-launcher-ui.mjs",
    "test": "node scripts/test-release.mjs",
    "test:voice": "node scripts/test-release.mjs --voice",
    "voice:install": "python -m pip install --target assets/voice-runtime/vendor -r scripts/requirements-voice.txt",
    "release:check": "node scripts/release-check.mjs",
    "test:release-docs": "node scripts/test-release-docs.mjs",
    "test:audit": "node scripts/test-release.mjs && node scripts/test-release.mjs --voice",
    "test:offline-replay": "node scripts/test-offline-replay.mjs",
    "preview:console": "node scripts/console-ui-fixture.mjs",
    "test:console-ui": "node scripts/test-console-ui.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@snowluma/mcp": "^1.14.20",
    "@snowluma/sdk": "^1.14.20",
    "zod": "^4.4.3"
  }
}
